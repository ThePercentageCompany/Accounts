# Operator-only configuration. Blank values deliberately prevent startup.
NODE_ENV=production
PORT=8080
APP_ORIGIN=
API_ORIGIN=
GOOGLE_OAUTH_CLIENT_ID=
# projects/.../secrets/.../versions/1 (JSON: {"clientSecret":"..."})
GOOGLE_OAUTH_SECRET_VERSION=
# Private operator-owned bucket; uniform bucket access + public access prevention.
CONTROL_BUCKET=
CONTROL_OBJECT=control/registry-v1.json
# projects/.../locations/.../keyRings/.../cryptoKeys/...
GOOGLE_REFRESH_KMS_KEY=
# Phase 1 uses identity scopes only. Offline Google connection is Phase 2.
