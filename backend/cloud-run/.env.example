# Operator-only configuration. Blank values deliberately prevent startup.
NODE_ENV=production
PORT=8080
APP_ORIGIN=
API_ORIGIN=
GOOGLE_OAUTH_CLIENT_ID=
# projects/.../secrets/.../versions/1 (JSON: {"clientSecret":"..."})
GOOGLE_OAUTH_SECRET_VERSION=
# Private operator-owned bucket; uniform bucket access + public access prevention.
CONTROL_BUCKET=
CONTROL_OBJECT=control/registry-v1.json
# projects/.../locations/.../keyRings/.../cryptoKeys/...
GOOGLE_REFRESH_KMS_KEY=
# Existing Cloud Tasks queue resource (operator setup, not a customer setting).
SETUP_TASK_QUEUE=
# Service-account email used to authenticate setup task deliveries.
SETUP_WORKER_EMAIL=
# Default HTTPS run.app origin of this same API service (no trailing slash).
SETUP_WORKER_ORIGIN=
# Owner sign-in uses identity only; /google/connect requests offline storage access.
